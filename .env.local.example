# Copy this file to .env.local and fill in your local values.
# .env.local is gitignored and never committed.

# Path to your local Godot executable
# Windows example: GODOT=C:\Users\yourname\AppData\Local\Programs\Godot\Godot_v4.6.exe
# Linux example:   GODOT=/usr/local/bin/godot
# Mac example:     GODOT=/Applications/Godot.app/Contents/MacOS/Godot
GODOT=
