; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="kronomania"
run/main_scene="res://scenes/hub/HubScene.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
config/main_scene="res://scenes/hub/HubScene.tscn"

[autoload]

RollEngine="*res://autoloads/RollEngine.gd"
CombatManager="*res://autoloads/CombatManager.gd"
PlayerProgression="*res://autoloads/PlayerProgression.gd"
DungeonManager="*res://autoloads/DungeonManager.gd"
DebugManager="*res://autoloads/DebugManager.gd"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
