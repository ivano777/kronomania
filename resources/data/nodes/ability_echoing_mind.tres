[sub_resource type="Resource" id="Level_1"]
script = ExtResource("2_ldscr")
branch_spend = {"ingenuity": 6}
prerequisites = [{
"node_id": "spellcasting",
"required_level": 1
}]
level_effect_description = "Inject Mind Lash: an arcane spell that echoes after you cast it. Each round end, it re-fires with one fewer kept die, until the echo dies out."
