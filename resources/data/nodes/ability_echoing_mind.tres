[resource]
script = ExtResource("1_ndscr")
node_id = "echoing_mind"
display_name = "Echoing Mind"
category = "ingenuity"
base_description = "Your spells do not end when cast. Tag a spell with the echo mark and it resounds at the end of each round, weakening with each pass."
