[sub_resource type="Resource" id="Level_2"]
script = ExtResource("2_ldscr")
level_index = 2
branch_spend = {"ingenuity": 6}
prerequisites = [{
"node_id": "echoing_mind",
"required_level": 1
}]
level_effect_description = "Every echo carries a flat bonus equal to the dice it keeps — the echo bites all the way down."
effect_type = "echoing_mind"

[resource]
script = ExtResource("1_ndscr")
node_id = "echoing_mind"
branch = "ingenuity"
display_name = "Echoing Mind"
category = "ingenuity"
base_description = "Your spells do not end when cast. Tag a spell with the echo mark and it resounds at the end of each round, weakening with each pass."
max_levels = 2
levels_data = Array[ExtResource("2_ldscr")]([SubResource("Level_1"), SubResource("Level_2")])
