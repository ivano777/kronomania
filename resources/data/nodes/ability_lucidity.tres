[sub_resource type="Resource" id="Level_1"]
script = ExtResource("2_ldscr")
prerequisites = [{
"node_id": "minor_studies",
"required_level": 1
}]
level_effect_description = "Action: lower your Fervor by 1 step. Costs your turn. Unlimited uses. Unavailable when Fervor is already minimal (d4)."
effect_type = "lucidity_lower_fervor"

[sub_resource type="Resource" id="Level_2"]
script = ExtResource("2_ldscr")
level_index = 2
required_tier = 3
prerequisites = [{
"node_id": "lucidity",
"required_level": 1
}]
level_effect_description = "Reactive: once per combat, when Fervor would cause Burnout, you may spend a charge to avert it. Fervor stays at the edge — this buys a reprieve, not relief."
effect_type = "lucidity_prevent_burnout"

[resource]
script = ExtResource("1_ndscr")
node_id = "lucidity"
display_name = "Lucidity"
category = "Ability"
base_description = "Master your own Fervor. Cool the burn before it consumes you."
max_levels = 2
levels_data = Array[ExtResource("2_ldscr")]([SubResource("Level_1"), SubResource("Level_2")])
