required_tier = 3
prerequisites = [{"node_id": "spellcasting", "required_level": 1}]
level_effect_description = "Inject Time Lock: an attack vs Resolve that, on a breach, freezes the next guard you strike — it will not reset or re-roll for 1 round, letting you press the same guard again."
