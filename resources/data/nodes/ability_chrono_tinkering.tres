required_tier = 3
prerequisites = [{"node_id": "chrono_tinkering", "required_level": 1}]
level_effect_description = "The freeze deepens — the guard stays locked for 2 rounds."
effect_type = "chrono_tinkering"

[resource]
script = ExtResource("1_ndscr")
node_id = "chrono_tinkering"
display_name = "Chrono-Tinkering"
category = "ingenuity"
base_description = "Master the thread of time itself. Break an enemy's Resolve and the next guard you strike will be frozen — it will not renew, letting you press the same value again and again."
max_levels = 2
levels_data = [SubResource("Level_1"), SubResource("Level_2")]
