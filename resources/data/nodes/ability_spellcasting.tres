[sub_resource type="Resource" id="Level_1"]
script = ExtResource("2_ldscr")
prerequisites = [{
"node_id": "minor_studies",
"required_level": 1
}]
level_effect_description = "Master Fervor channeling. Cast true spells with Ingenuity + Fervor die. Unlocks Arcane Missile (vs Stance) and Arcane Mark (vs Resolve)."
effect_type = "spellcasting"
spells = Array[ExtResource("4_wcqf8")]([ExtResource("5_missile"), ExtResource("6_mark")])

