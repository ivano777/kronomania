[sub_resource type="Resource" id="Level_2"]
script = ExtResource("2_ldscr")
level_index = 2
branch_spend = {"ingenuity": 3}
prerequisites = [{
"node_id": "spellcasting",
"required_level": 1
}]
level_effect_description = "Magical mastery deepens. All arcane casts gain Keep 2. Arcane Missile strikes harder (+1). When Arcane Mark breaks the mind, the enemy's Stance falters (-2)."
bonus_effects = Array[ExtResource("3_bescr")]([SubResource("BonusKeep_2"), SubResource("BonusFlatAM_2")])
outcome_effects = Array[ExtResource("4_oescr")]([SubResource("OutcomeFlat_2")])

