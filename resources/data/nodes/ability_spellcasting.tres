[resource]
script = ExtResource("1_ndscr")
node_id = "spellcasting"
branch = "ingenuity"
display_name = "Spellcasting"
category = "Ability"
base_description = "You have mastered Fervor channeling. Cast true spells using Ingenuity + a real Fervor die. Each max-roll escalates Fervor instability."
max_levels = 3
levels_data = Array[ExtResource("2_ldscr")]([SubResource("Level_1"), SubResource("Level_2"), SubResource("Level_3")])
